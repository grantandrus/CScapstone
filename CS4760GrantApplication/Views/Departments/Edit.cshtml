@model CS4760GrantApplication.ViewModels.DepartmentCreateViewModel

@{
	ViewData["Title"] = "Edit Department";
}

<h1>Edit Department</h1>

<div class="row">
	<div class="col-md-6">
		<form asp-action="Edit">
			<div asp-validation-summary="ModelOnly" class="text-danger"></div>

			<!-- Hidden input for ID -->
			<input type="hidden" asp-for="Id" />
			
            <div class="form-group mb-3">
                <label asp-for="DepartmentName" class="control-label"></label>
                <input asp-for="DepartmentName" class="form-control" />
                <span asp-validation-for="DepartmentName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label for="chairId" class="control-label">Chair</label>
                <select name="chairId" class="form-control" asp-items="ViewBag.Chairs">
                    <option value="">Select a Chair (Optional)</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label for="collegeId" class="control-label">College</label>
                <select name="collegeId" class="form-control" asp-items="ViewBag.Colleges">
                    <option value="">Select a College (Optional)</option>
                </select>
            </div>

			<div class="form-group">
				<input type="submit" value="Update Department" class="btn btn-primary" />
				<a asp-controller="Departments" asp-action="Index" class="btn btn-danger ms-2">Cancel</a>
			</div>
		</form>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}