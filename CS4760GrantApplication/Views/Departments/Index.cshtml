@model IEnumerable<CS4760GrantApplication.Models.Department>

@{
    ViewData["Title"] = "Departments";
}

<h1>Departments</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Department</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Department Name
            </th>
            <th>
                Description
            </th>
            <th>
                Chair
            </th>
            <th>
                College
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.DepartmentName
                </td>
                <td>
                    @item.Description
                </td>
                <td>
                    @(@item.Chair == null ? "None" : @item.Chair.FirstName + @item.Chair.LastName)
                </td>
                <td>
                    @(@item.College == null ? "None" : @item.College.Name)
                </td>
                <td>
                    <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("Edit", "Departments", new { id = item.Id })'">Edit</button>
                </td>
            </tr>
        }
    </tbody>
</table>