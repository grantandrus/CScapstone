@model IEnumerable<CS4760GrantApplication.Models.Grant>
@{
    ViewData["Title"] = "Review";
}

<table class="table">
    <thead>
        <tr>
            <th>
                Grant Title
            </th>
            <th>
                Project Director
            </th>
            <th>
                Requested Funds
            </th>
            <th>
                Review / Review Score
             </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Title
                </td>
                <td>
                    @(item.User.FirstName + " " + item.User.LastName)
                </td>
                <td>
                    @{
                        decimal total = 0;
                    }
                    @foreach (var budgetItem in item.BudgetItems)
                    {
                        @if (budgetItem.FundingSource == "ARCC")
                        {
                        
                            total += budgetItem.Amount;
                       
                        }
                    }
                    @total
                </td>
                @if (item.Review != null)
                {
                    <td>
                        @item.Review.AverageScore
                    </td>
                } else
                {
                <td>
                    <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("ReviewGrant", "Review", new { id = item.Id })'">Review</button>
                </td>
                }
            </tr>
        }
    </tbody>
</table>