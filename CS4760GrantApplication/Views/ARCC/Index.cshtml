@model CS4760GrantApplication.ViewModels.ARCCViewModel
@{
    ViewData["Title"] = "ARCC Committee";
}

<h1>ARCC Committee</h1>

<h2>Members</h2>
<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Department</th>
            <th>Remove from Committee</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Members)
        {
            <tr>
                <td>@member.FirstName</td>
                <td>@member.LastName</td>
                <td>@member.Department.DepartmentName</td>
                <td>
                    @using (Html.BeginForm("Remove", "Members", new { id = member.Id }, FormMethod.Post))
                    {
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<h2>Add Members</h2>
<table class="table">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Department</th>
            <th>Add to Committee</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.OtherUsers)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>@user.Department.DepartmentName</td>
                <td>
                    @using (Html.BeginForm("Add", "OtherUsers", new { id = user.Id }, FormMethod.Post))
                    {
                        <button type="submit" class="btn btn-outline-success"><i class="bi bi-plus-lg"></i></button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>