@model CS4760GrantApplication.ViewModels.ARCCViewModel
@{
    ViewData["Title"] = "ARCC Committee";
}

<h1>ARCC Committee</h1>

<h2>Committee Chair</h2>
<form asp-action="UpdateChair" asp-controller="ARCC" method="post" class="mb-4">
    <select name="selectedUserId" class="form-select me-2" style="max-width: 300px;" onchange="this.form.submit()">
        @if (Model.CurrentChairId == null)
        {
            <option value="" selected disabled>No chair assigned</option>
        }

        @if (Model.Members != null)
        {
            @foreach (var user in Model.Members)
            {
                if (Model.CurrentChairId == user.Id)
                {
                    <option value="@user.Id" selected>@user.FirstName @user.LastName</option>
                }
                else
                {
                    <option value="@user.Id">@user.FirstName @user.LastName</option>
                }
            }
        }
    </select>
</form>

<h2>Members</h2>
<table class="table mb-4">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Department</th>
            <th>Remove from Committee</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var member in Model.Members)
        {
            <tr>
                <td>@member.FirstName</td>
                <td>@member.LastName</td>
                <td>
                    @if(!(member.Department is null)){
                        @member.Department.DepartmentName
                    
                    }</td>
                <td>
                    @using (Html.BeginForm("Remove", "ARCC", new { id = member.Id }, FormMethod.Post))
                    {
                        <button type="submit" class="btn btn-outline-danger">Remove</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<h2>Add Members</h2>
<table class="table mb-4">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Department</th>
            <th>Add to Committee</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.OtherUsers)
        {
            <tr>
                <td>@user.FirstName</td>
                <td>@user.LastName</td>
                <td>
                    @if(!(user.Department is null)) {                       
                        @user.Department.DepartmentName
                    }
                </td>
                <td>
                    @using (Html.BeginForm("Add", "ARCC", new { id = user.Id }, FormMethod.Post))
                    {
                        <button type="submit" class="btn btn-outline-success">Add</button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Display grants saved for review -->
<h2>Submitted Grants for Review</h2>
<table class="table mb-4">
    <thead>
        <tr>
            <th>Grant Title</th>
            <th>Principal Investigator</th>
            <th>Amount Requested</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.SubmittedGrants != null && Model.SubmittedGrants.Any())
        {
            @foreach (var grant in Model.SubmittedGrants)
            {
                <tr>
                    <td>@grant.Title</td>
                    <td>@grant.User?.FirstName @grant.User?.LastName</td>
                    <td>@grant.BudgetItems.Sum(b => b.Amount).ToString("C")</td>
                    <td>
                        <a asp-controller="Grant" asp-action="Details" asp-route-id="@grant.Id" class="btn btn-outline-primary">Review</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No grants pending review.</td>
            </tr>
        }
    </tbody>
</table>
