@model CS4760GrantApplication.ViewModels.ARCCReportViewModel
@{
    var CollegeXLabels = Newtonsoft.Json.JsonConvert.SerializeObject(Model.CollegeData.Select(x => x.DimensionOne).ToList());
    var CollegeYValues = Newtonsoft.Json.JsonConvert.SerializeObject(Model.CollegeData.Select(y => y.Quantity).ToList());

    var DepartmentXLabels = Newtonsoft.Json.JsonConvert.SerializeObject(Model.DepartmentData.Select(x => x.DimensionOne).ToList());
    var DepartmentYValues = Newtonsoft.Json.JsonConvert.SerializeObject(Model.DepartmentData.Select(y => y.Quantity).ToList());

    var RejectXLabels = Newtonsoft.Json.JsonConvert.SerializeObject(Model.RejectData.Select(x => x.DimensionOne).ToList());
    var RejectYValues = Newtonsoft.Json.JsonConvert.SerializeObject(Model.RejectData.Select(y => y.Quantity).ToList());
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.7.2/Chart.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>

<h1>ARCC Report</h1>

<h3 class="mb-3 mt-3 text-center">Total money allocated: $@Model.AllocatedString</h3>

<h3 class="text-center mb-2">Allocation by College</h3>
<div class="box-body">
    <div class="chart-container">
        <canvas id="chartCollege" style="width:100%; height:500px"></canvas>
    </div>
</div>

<h3 class="text-center mb-2">Allocation by Principle Investigator Department</h3>
<div class="box-body">
    <div class="chart-container">
        <canvas id="chartDepartment" style="width:100%; height:500px"></canvas>
    </div>
</div>

<h3 class="text-center mb-2">ARCC Accept vs Reject Rate</h3>
<div class="box-body">
    <div class="chart-container">
        <canvas id="chartReject" style="width:100%; height:500px"></canvas>
    </div>
</div>


<script type="text/javascript">
    $(function() {
        var chartName = "chartCollege";
        var ctx = document.getElementById(chartName).getContext('2d');
        var data = {
            labels: @Html.Raw(CollegeXLabels),
            datasets: [{
                label: "Allocation by College",
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(153, 102, 255, 0.2)',
                    'rgba(255, 159, 64, 0.2)',
                    'rgba(255, 0, 0)',
                    'rgba(0, 255, 0)',
                    'rgba(0, 0, 255)',
                    'rgba(192, 192, 192)',
                    'rgba(255, 255, 0)',
                    'rgba(255, 0, 255)'
                ],
                borderColor: [
                    'rgba(255,99,132,1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)',
                    'rgba(255, 0, 0)',
                    'rgba(0, 255, 0)',
                    'rgba(0, 0, 255)',
                    'rgba(192, 192, 192)',
                    'rgba(255, 255, 0)',
                    'rgba(255, 0, 255)'
                ],
                borderWidth: 1,
                data: @Html.Raw(CollegeYValues)
        }]
        };

        var options = {
            maintainAspectRatio: false,
            scales: {
                yAxes: [{
                    ticks: {
                        min: 0,
                        beginAtZero: true
                    },
                    gridLines: {
                        display: true,
                        color: "rgba(255,99,164,0.2)"
                    }
                }],
                xAxes: [{
                    ticks: {
                        min: 0,
                        beginAtZero: true
                    },
                    gridLines: {
                        display: false
                    }
                }]
            }
        };

        var myChart = new Chart(ctx, {
            options: options,
            data: data,
            type: 'pie'

        });
    });

    $(function() {
