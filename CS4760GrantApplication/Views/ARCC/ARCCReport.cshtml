@model CS4760GrantApplication.ViewModels.ARCCReportViewModel
@{
    var CollegeXLabels = Newtonsoft.Json.JsonConvert.SerializeObject(Model.CollegeData.Select(x => x.DimensionOne).ToList());
    var CollegeYValues = Newtonsoft.Json.JsonConvert.SerializeObject(Model.CollegeData.Select(y => y.Quantity).ToList());

    var DepartmentXLabels = Newtonsoft.Json.JsonConvert.SerializeObject(Model.DepartmentData.Select(x => x.DimensionOne).ToList());
    var DepartmentYValues = Newtonsoft.Json.JsonConvert.SerializeObject(Model.DepartmentData.Select(y => y.Quantity).ToList());

    var RejectXLabels = Newtonsoft.Json.JsonConvert.SerializeObject(Model.RejectData.Select(x => x.DimensionOne).ToList());
    var RejectYValues = Newtonsoft.Json.JsonConvert.SerializeObject(Model.RejectData.Select(y => y.Quantity).ToList());

    var TopXLabels = Newtonsoft.Json.JsonConvert.SerializeObject(Model.TopData.Select(x => x.DimensionOne).ToList());
    var TopYValues = Newtonsoft.Json.JsonConvert.SerializeObject(Model.TopData.Select(x => x.Quantity).ToList());
}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.7.2/Chart.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.3.1.min.js"></script>

<h1>ARCC Report</h1>

<h3 class="mb-3 mt-3 text-center">Total money allocated: $@Model.AllocatedString</h3>

<h3 class="text-center mb-2">Allocation by College</h3>
<div class="box-body">
    <div class="chart-container">
        <canvas id="chartCollege" style="width:100%; height:500px"></canvas>
    </div>
</div>

<h3 class="text-center mb-2">Allocation by Principle Investigator Department</h3>
<div class="box-body">
    <div class="chart-container">
        <canvas id="chartDepartment" style="width:100%; height:500px"></canvas>
    </div>
</div>

<h3 class="text-center mb-2">ARCC Accept vs Reject Rate</h3>
<div class="box-body">
    <div class="chart-container">
        <canvas id="chartReject" style="width:100%; height:500px"></canvas>
    </div>
</div>

<h3 class="text-center mb-2">Top 5 Grants Allocated Funds From ARCC</h3>
<div class="box-body">
    <div class="chart-container">
        <canvas id="chartTop" style="width:100%; height:500px"></canvas>
    </div>
</div>

<input type="text"
       id="searchBar"
       class="form-control mb-3"
       placeholder="Search..." />

<div class="bg-warning-subtle" style="margin-bottom:20px;">
    <span class="bg-opacity-75">Use &lt;### or &gt;### to filter Allocated Funds</span>
</div>

<div class="btn-group mb-3">

    <button type="button"
            class="btn btn-primary filter-btn active"
            data-field="title">
        Title
    </button>

    <button type="button"
            class="btn btn-primary filter-btn active"
            data-field="pi">
        Name
    </button>

    <button type="button"
            class="btn btn-primary filter-btn active"
            data-field="status">
        Status
    </button>

    <button type="button"
            class="btn btn-primary filter-btn active"
            data-field="department">
        Department
    </button>

    <button type="button"
            class="btn btn-primary filter-btn active"
            data-field="college">
        College
    </button>

    <button type="button"
            class="btn btn-secondary filter-btn"
            data-field="allocatedfunds">
        Allocated Funds
    </button>

</div>

<table class="table table-striped" id="grantTable">

    <thead>
        <tr>
            <th>Title</th>
            <th>Name</th>
            <th>Status</th>
            <th>Allocated Funds</th>
            <th>Department</th>
            <th>College</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var grant in Model.AllocatedGrants)
        {
            <tr data-title="@grant.Title"
                data-pi="@($"{grant.User.FirstName} {grant.User.LastName}")"
                data-status="@grant.Status"
                data-allocatedfunds="@grant.AllocatedFunds"
                data-department="@grant.Departments.FirstOrDefault()?.DepartmentName"
                data-college="@grant.College.Name">

                <td>@grant.Title</td>
                <td>@grant.User.FirstName @grant.User.LastName</td>
                <td>@grant.Status</td>
                <td>@grant.AllocatedFunds</td>
                <td>@grant.Departments.FirstOrDefault()?.DepartmentName</td>
                <td>@grant.College.Name</td>

            </tr>
        }

    </tbody>

</table>



<script type="text/javascript">
    const searchBar = document.getElementById("searchBar");
    const rows = document.querySelectorAll("#grantTable tbody tr");
    const filterButtons = document.querySelectorAll(".filter-btn");

    // Toggle buttons
    filterButtons.forEach(button => {

        button.addEventListener("click", function () {

            const isAllocated = this.dataset.field === "allocatedfunds";

            if (isAllocated) {

                // Turn off every other filter
                filterButtons.forEach(btn => {

                    if (btn.dataset.field !== "allocatedfunds") {

                        btn.classList.remove("active");
                        btn.classList.remove("btn-primary");
                        btn.classList.add("btn-outline-primary");

                    }

                });

                // Toggle Allocated Funds
                this.classList.toggle("active");
                this.classList.toggle("btn-secondary");
                this.classList.toggle("btn-outline-secondary");

            }
            else {

                // If Allocated Funds is active, turn it off
                const allocatedButton =
                    document.querySelector('[data-field="allocatedfunds"]');

                allocatedButton.classList.remove("active");
                allocatedButton.classList.remove("btn-secondary");
                allocatedButton.classList.add("btn-outline-secondary");

                // Toggle the clicked button
                this.classList.toggle("active");
                this.classList.toggle("btn-primary");
                this.classList.toggle("btn-outline-primary");

            }

            filterTable();

        });

    });

    searchBar.addEventListener("input", filterTable);

    function filterTable() {

        const filter = searchBar.value.trim().toLowerCase();

        rows.forEach(row => {

            let found = false;

            filterButtons.forEach(button => {

                if (!button.classList.contains("active"))
                    return;

                const field = button.dataset.field;

                // Lookup table
                const searchFields = {

                    title: () => row.dataset.title ?? "",

                    pi: () => row.dataset.pi ?? "",

                    status: () => row.dataset.status ?? "",

                    department: () => row.dataset.department ?? "",

                    college: () => row.dataset.college ?? "",

                    allocatedfunds: () => parseFloat(row.dataset.allocatedfunds ?? "0")

                };

                if (!searchFields[field])
                    return;

                const value = searchFields[field]();

                if (field === "allocatedfunds") {

                    const amount = Number(value);

                    if (filter.startsWith(">")) {
                        found = amount > Number(filter.substring(1));
                    }
                    else if (filter.startsWith("<")) {
                        found = amount < Number(filter.substring(1));
                    }
                    else {
                        found = amount.toString().includes(filter);
                    }

                }
                else {

                    found = value.toLowerCase().includes(filter);
                }

            });

            row.style.display = (filter === "" || found)
                ? ""
                : "none";

        });

    }

    $(function() {
        var chartName = "chartCollege";
        var ctx = document.getElementById(chartName).getContext('2d');
        var data = {
            labels: @Html.Raw(CollegeXLabels),
            datasets: [{
                label: "Allocation by College",
                backgroundColor: [
                    'rgba(255, 99, 132, 0.2)',
                    'rgba(54, 162, 235, 0.2)',
                    'rgba(255, 206, 86, 0.2)',
                    'rgba(75, 192, 192, 0.2)',
                    'rgba(153, 102, 255, 0.2)',
                    'rgba(255, 159, 64, 0.2)',
                    'rgba(255, 0, 0)',
                    'rgba(0, 255, 0)',
                    'rgba(0, 0, 255)',
                    'rgba(192, 192, 192)',
                    'rgba(255, 255, 0)',
                    'rgba(255, 0, 255)'
                ],
                borderColor: [
                    'rgba(255,99,132,1)',
                    'rgba(54, 162, 235, 1)',
                    'rgba(255, 206, 86, 1)',
                    'rgba(75, 192, 192, 1)',
                    'rgba(153, 102, 255, 1)',
                    'rgba(255, 159, 64, 1)',
                    'rgba(255, 0, 0)',
                    'rgba(0, 255, 0)',
                    'rgba(0, 0, 255)',
                    'rgba(192, 192, 192)',
                    'rgba(255, 255, 0)',
                    'rgba(255, 0, 255)'
                ],
                borderWidth: 1,
                data: @Html.Raw(CollegeYValues)
        }]
        };

        var options = {
            maintainAspectRatio: false,
            scales: {
                yAxes: [{
                    ticks: {
                        min: 0,
                        beginAtZero: true
                    },
                    gridLines: {
                        display: true,
                        color: "rgba(255,99,164,0.2)"
                    }
                }],
                xAxes: [{
                    ticks: {
                        min: 0,
                        beginAtZero: true
                    },
                    gridLines: {
                        display: false
                    }
                }]
            }
        };

        var myChart = new Chart(ctx, {
            options: options,
            data: data,
            type: 'pie'

        });
    });

