@model CS4760GrantApplication.ViewModels.EditPasswordViewModel;

@{
    ViewData["Title"] = "Edit Password";
}

<div style="max-width: 400px; margin: 80px auto;">
    <h2>Edit Password</h2>

    <!-- Display error if there is one -->
    @if (ViewBag.Error != null)
    {
        <div style="color: red; margin-bottom: 12px;">@ViewBag.Error</div>
    }

    <form asp-action="EditPassword" method="post" autocomplete="off" AutoCompleteType="Disabled">

        <input type="hidden" asp-for="UserID" />

        <div class="form-group">
            <label asp-for="Password" style="padding-top: 10px"></label>
            <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword" style="padding-top: 10px">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <br />

        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>