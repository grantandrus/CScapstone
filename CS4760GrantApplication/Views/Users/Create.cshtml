@model CS4760GrantApplication.ViewModels.RegisterViewModel;

@{
    ViewData["Title"] = "Create New User";
}

<div style="max-width: 400px; margin: 80px auto;">
    <h2>User Registration</h2>

    <!-- Display error if there is one -->
    @if (ViewBag.Error != null)
    {
        <div style="color: red; margin-bottom: 12px;">@ViewBag.Error</div>
    }

    <form asp-action="Create" method="post" autocomplete="off" AutoCompleteType="Disabled">

        <div class="form-group">
            <label asp-for="Email">Email</label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="FirstName">First Name</label>
            <input asp-for="FirstName" class="form-control" />
            <span asp-validation-for="FirstName" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="LastName">Last Name</label>
            <input asp-for="LastName" class="form-control" />
            <span asp-validation-for="LastName" class="text-danger"></span>
        </div>
       
        <div class="form-group">
            <label asp-for="Password" style="padding-top: 10px"></label>
            <input asp-for="Password" class="form-control" type="password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword" style="padding-top: 10px">Confirm Password</label>
            <input asp-for="ConfirmPassword" class="form-control" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <br />

        <button type="submit" class="btn btn-primary">Create User</button>
    </form>
</div>