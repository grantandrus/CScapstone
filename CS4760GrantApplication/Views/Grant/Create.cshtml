@model CS4760GrantApplication.ViewModels.CreateGrantViewModel

@{
    ViewData["Title"] = "Grant Request";
}

<h1>Grant Request</h1>
<div class="text-secondary">Opened at: @DateTime.Now</div>
<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="IsSaved" type="hidden" id="IsSaved" />

            <div class="form-group mb-3">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <textarea asp-for="Description" class="form-control"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ProjectSummary" class="control-label"></label>
                <textarea asp-for="ProjectSummary" class="form-control"></textarea>
                <span asp-validation-for="ProjectSummary" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Justification" class="control-label"></label>
                <textarea asp-for="Justification" class="form-control"></textarea>
                <span asp-validation-for="Justification" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ProjectImpact" class="control-label"></label>
                <input asp-for="ProjectImpact" class="form-control" />
                <span asp-validation-for="ProjectImpact" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ProjectTimeline" class="control-label"></label>
                <textarea asp-for="ProjectTimeline" class="form-control"></textarea>
                <span asp-validation-for="ProjectTimeline" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="SuccessEvaluation" class="control-label"></label>
                <textarea asp-for="SuccessEvaluation" class="form-control"></textarea>
                <span asp-validation-for="SuccessEvaluation" class="text-danger"></span>
            </div>

            <hr />

            <h3>Budget Worksheet</h3>

            <p class="text-muted">
                Save this grant as a draft first. After saving, open the grant from your dashboard
                and use the Budget Worksheet button to add budget items.
            </p>

            <div class="form-check mb-3">
                <input asp-for="isMultipleDepartments" class="form-check-input" />
                <label asp-for="isMultipleDepartments" class="form-check-label"></label>
            </div>

            <div class="form-group mb-3">
                <label>Departments</label>

                <select asp-for="SelectedDepartmentIds"
                        asp-items="Model.Departments"
                        class="form-control"
                        multiple>
                </select>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Project Director</label>
                <select asp-for="UserId"
                        asp-items="Model.Users"
                        class="form-control">
                    <option value="">-- Select Project Director --</option>
                </select>
                <span asp-validation-for="UserId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">College</label>
                <select asp-for="CollegeId"
                        asp-items="Model.Colleges"
                        class="form-control">
                    <option value="">-- Select College --</option>
                </select>
                <span asp-validation-for="CollegeId"
                      class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Attachments (up to 3 files)</label>
                <div class="mb-2">
                    <input type="file" name="attachments" class="form-control" />
                </div>
                <div class="mb-2">
                    <input type="file" name="attachments" class="form-control" />
                </div>
                <div>
                    <input type="file" name="attachments" class="form-control" />
                </div>
                <span class="text-danger">@Html.ValidationMessage("attachments")</span>
            </div>

            <div class="form-group mb-3 form-check">
                <input asp-for="InvolvesHumanOrAnimalSubjects" class="form-check-input" />
                <label asp-for="InvolvesHumanOrAnimalSubjects" class="form-check-label">
                    Does this grant involve human or animal subjects?
                </label>
            </div>

            <div class="form-group mb-3">
                <label class="control-label">Approval File</label>
                <input type="file" name="approvalFile" class="form-control" />
                <span class="text-danger">@Html.ValidationMessage("approvalFile")</span>
            </div>

            <div class="form-group">
                <button type="button"
                        class="btn btn-primary"
                        data-bs-toggle="modal"
                        data-bs-target="#acknowledgements-modal">
                    Submit
                </button>

                <button type="submit"
                        class="btn btn-secondary"
                        onclick="document.getElementById('IsSaved').value='true';">
                    Save Draft
                </button>
            </div>

            <!-- a modal to contain acknowledgements/signature (to help the application from getting too crowded) -->
            <div class="modal fade" id="acknowledgements-modal" tabindex="-1" aria-labelledby="acknowledgements-title" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="acknowledgements-title">Acknowledgements</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <div class="form-check mb-3">
                                <input asp-for="Acknowledgement1" class="form-check-input" />
                                <label asp-for="Acknowledgement1" class="form-check-label">Acknowledgement 1</label>
                            </div>
                            <div class="form-check mb-3">
                                <input asp-for="Acknowledgement2" class="form-check-input" />
                                <label asp-for="Acknowledgement2" class="form-check-label">Acknowledgement 2</label>
                            </div>
                            <div class="form-check mb-3">

                                <input asp-for="Acknowledgement3" class="form-check-input" />
                                <label asp-for="Acknowledgement3" class="form-check-label">Acknowledgement 3</label>
                            </div>
                            <div class="form-check mb-3">
                                <input asp-for="Acknowledgement4" class="form-check-input" />
                                <label asp-for="Acknowledgement4" class="form-check-label">Acknowledgement 4</label>
                            </div>
                            <div class="d-flex gap-3  mb-3">
                                <div class="form-group">
                                    <label asp-for="Signature" class="control-label"></label>
                                    <input asp-for="Signature" class="form-control" />
                                </div>
                                <div class="form-group">
                                    @Html.LabelFor(m => m.SignatureDate, "Date", htmlAttributes: new { @class = "control-label" })
                                    @Html.EditorFor(m => m.SignatureDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                    <p class="text-secondary">Today's Date: @DateTime.Now.ToString("MM/dd/yyyy")</p>
                                </div>
                            </div>
                        </div>
                    
                        <div class="modal-footer">
                            <button type="submit"
                                    class="btn btn-primary"
                                    onclick="document.getElementById('IsSaved').value='false';">
                                Submit
                            </button>
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
            
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const multiDeptCheckbox =
            document.getElementById('isMultipleDepartments');

        const departmentSelect =
            document.getElementById('SelectedDepartmentIds');

        departmentSelect.addEventListener('change', function () {

            if (!multiDeptCheckbox.checked) {

                const selected =
                    Array.from(departmentSelect.selectedOptions);

                if (selected.length > 1) {

                    selected[selected.length - 1].selected = false;

                    alert(
                        "Check 'Multiple Departments' to select more than one department."
                    );
                }
            }
        });
    });
</script>