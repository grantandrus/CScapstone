@model CS4760GrantApplication.ViewModels.CreateGrantViewModel

@{
    ViewData["Title"] = "Grant Request";
}

<style>
    .grant-section-heading {
        color: var(--bs-primary);
        margin-top: 2rem;
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid var(--bs-border-color);
    }

    textarea.form-control {
        min-height: 110px;
        resize: vertical;
    }

    .grant-form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .grant-form-actions .btn {
        min-width: 125px;
    }
</style>

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-4">
            <div>
                <h1 class="mb-1">Grant Request</h1>

                <p class="text-muted mb-0">
                    Complete the information below to create a new grant application.
                </p>
            </div>

            <small class="text-muted">
                Opened @DateTime.Now.ToString("MM/dd/yyyy h:mm tt")
            </small>
        </div>

        <div class="card border-0 shadow-sm mb-5">
            <div class="card-body p-4 p-lg-5">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert">
                    </div>

                    <input asp-for="IsSaved"
                           type="hidden"
                           id="IsSaved" />

                    <h2 class="h4 grant-section-heading mt-0">
                        General Information
                    </h2>

                    <div class="mb-3">
                        <label asp-for="Title"
                               class="form-label">
                        </label>

                        <input asp-for="Title"
                               class="form-control" />

                        <span asp-validation-for="Title"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description"
                               class="form-label">
                        </label>

                        <textarea asp-for="Description"
                                  class="form-control">
                        </textarea>

                        <span asp-validation-for="Description"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProjectSummary"
                               class="form-label">
                        </label>

                        <textarea asp-for="ProjectSummary"
                                  class="form-control">
                        </textarea>

                        <span asp-validation-for="ProjectSummary"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Justification"
                               class="form-label">
                        </label>

                        <textarea asp-for="Justification"
                                  class="form-control">
                        </textarea>

                        <span asp-validation-for="Justification"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProjectImpact"
                               class="form-label">
                        </label>

                        <input asp-for="ProjectImpact"
                               class="form-control" />

                        <span asp-validation-for="ProjectImpact"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ProjectTimeline"
                               class="form-label">
                        </label>

                        <textarea asp-for="ProjectTimeline"
                                  class="form-control">
                        </textarea>

                        <span asp-validation-for="ProjectTimeline"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="SuccessEvaluation"
                               class="form-label">
                        </label>

                        <textarea asp-for="SuccessEvaluation"
                                  class="form-control">
                        </textarea>

                        <span asp-validation-for="SuccessEvaluation"
                              class="text-danger">
                        </span>
                    </div>

                    <h2 class="h4 grant-section-heading">
                        Budget Worksheet
                    </h2>

                    <div class="alert alert-info" role="alert">
                        <div class="fw-semibold mb-1">
                            Budget items are added after saving.
                        </div>

                        Save this grant as a draft, open it from your dashboard,
                        and then select <strong>Budget Worksheet</strong> to add expenses.
                    </div>

                    <h2 class="h4 grant-section-heading">
                        Organization Information
                    </h2>

                    <div class="form-check mb-3">
                        <input asp-for="isMultipleDepartments"
                               class="form-check-input" />

                        <label asp-for="isMultipleDepartments"
                               class="form-check-label">
                        </label>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Departments
                        </label>

                        <select asp-for="SelectedDepartmentIds"
                                asp-items="Model.Departments"
                                class="form-select"
                                multiple>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Project Director
                        </label>

                        <select asp-for="UserId"
                                asp-items="Model.Users"
                                class="form-select">
                            <option value="">
                                -- Select Project Director --
                            </option>
                        </select>

                        <span asp-validation-for="UserId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            College
                        </label>

                        <select asp-for="CollegeId"
                                asp-items="Model.Colleges"
                                class="form-select">
                            <option value="">
                                -- Select College --
                            </option>
                        </select>

                        <span asp-validation-for="CollegeId"
                              class="text-danger">
                        </span>
                    </div>

                    <h2 class="h4 grant-section-heading">
                        Compliance &amp; Attachments
                    </h2>

                    <div class="mb-4">
                        <label class="form-label">
                            Attachments
                        </label>

                        <div class="form-text mb-2">
                            You may upload up to three files.
                        </div>

                        <div class="mb-2">
                            <input type="file"
                                   name="attachments"
                                   class="form-control" />
                        </div>

                        <div class="mb-2">
                            <input type="file"
                                   name="attachments"
                                   class="form-control" />
                        </div>

                        <div>
                            <input type="file"
                                   name="attachments"
                                   class="form-control" />
                        </div>

                        <span class="text-danger">
                            @Html.ValidationMessage("attachments")
                        </span>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="InvolvesHumanOrAnimalSubjects"
                               class="form-check-input" />

                        <label asp-for="InvolvesHumanOrAnimalSubjects"
                               class="form-check-label">
                            Does this grant involve human or animal subjects?
                        </label>
                    </div>

                    <div class="form-check mb-3">
                        <input asp-for="HasAbroadSupport"
                               class="form-check-input" />

                        <label asp-for="HasAbroadSupport"
                               class="form-check-label">
                            Does this grant have international support?
                        </label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dissemination"
                               class="form-label">
                        </label>

                        <textarea asp-for="Dissemination"
                                  class="form-control">
                        </textarea>

                        <span asp-validation-for="Dissemination"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Approval File
                        </label>

                        <input type="file"
                               name="approvalFile"
                               class="form-control" />

                        <span class="text-danger">
                            @Html.ValidationMessage("approvalFile")
                        </span>
                    </div>

                    <hr class="my-4" />

                    <div class="grant-form-actions">
                        <button type="button"
                                class="btn btn-primary"
                                data-bs-toggle="modal"
                                data-bs-target="#acknowledgements-modal">
                            Submit
                        </button>

                        <button type="submit"
                                class="btn btn-secondary"
                                onclick="document.getElementById('IsSaved').value='true';">
                            Save Draft
                        </button>
                    </div>

                    <div class="modal fade"
                         id="acknowledgements-modal"
                         tabindex="-1"
                         aria-labelledby="acknowledgements-title"
                         aria-hidden="true">

                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h2 class="modal-title fs-5"
                                        id="acknowledgements-title">
                                        Acknowledgements
                                    </h2>

                                    <button type="button"
                                            class="btn-close"
                                            data-bs-dismiss="modal"
                                            aria-label="Close">
                                    </button>
                                </div>

                                <div class="modal-body">
                                    <p class="text-muted">
                                        Review and confirm each acknowledgement before
                                        submitting the grant.
                                    </p>

                                    <div class="form-check mb-3">
                                        <input asp-for="Acknowledgement1"
                                               class="form-check-input" />

                                        <label asp-for="Acknowledgement1"
                                               class="form-check-label">
                                            Acknowledgement 1
                                        </label>
                                    </div>

                                    <div class="form-check mb-3">
                                        <input asp-for="Acknowledgement2"
                                               class="form-check-input" />

                                        <label asp-for="Acknowledgement2"
                                               class="form-check-label">
                                            Acknowledgement 2
                                        </label>
                                    </div>

                                    <div class="form-check mb-3">
                                        <input asp-for="Acknowledgement3"
                                               class="form-check-input" />

                                        <label asp-for="Acknowledgement3"
                                               class="form-check-label">
                                            Acknowledgement 3
                                        </label>
                                    </div>

                                    <div class="form-check mb-4">
                                        <input asp-for="Acknowledgement4"
                                               class="form-check-input" />

                                        <label asp-for="Acknowledgement4"
                                               class="form-check-label">
                                            Acknowledgement 4
                                        </label>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-7">
                                            <label asp-for="Signature"
                                                   class="form-label">
                                            </label>

                                            <input asp-for="Signature"
                                                   class="form-control" />

                                            <span asp-validation-for="Signature"
                                                  class="text-danger">
                                            </span>
                                        </div>

                                        <div class="col-md-5">
                                            @Html.LabelFor(
                                                m => m.SignatureDate,
                                                "Date",
                                                htmlAttributes: new
                                                {
                                                    @class = "form-label"
                                                }
                                            )

                                            @Html.EditorFor(
                                                m => m.SignatureDate,
                                                new
                                                {
                                                    htmlAttributes = new
                                                    {
                                                        @class = "form-control",
                                                        type = "date"
                                                    }
                                                }
                                            )

                                            <div class="form-text">
                                                Today's date:
                                                @DateTime.Now.ToString("MM/dd/yyyy")
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="button"
                                            class="btn btn-outline-secondary"
                                            data-bs-dismiss="modal">
                                        Close
                                    </button>

                                    <button type="submit"
                                            class="btn btn-primary"
                                            onclick="document.getElementById('IsSaved').value='false';">
                                        Submit Grant
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {

        const multiDeptCheckbox =
            document.getElementById('isMultipleDepartments');

        const departmentSelect =
            document.getElementById('SelectedDepartmentIds');

        departmentSelect.addEventListener('change', function () {

            if (!multiDeptCheckbox.checked) {

                const selected =
                    Array.from(departmentSelect.selectedOptions);

                if (selected.length > 1) {

                    selected[selected.length - 1].selected = false;

                    alert(
                        "Check 'Multiple Departments' to select more than one department."
                    );
                }
            }
        });
    });
</script>