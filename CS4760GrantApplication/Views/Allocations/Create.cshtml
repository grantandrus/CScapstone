@model CS4760GrantApplication.Models.Allocation

@{
    ViewData["Title"] = "Create";
}

<h1>Allocations</h1>

@if (ViewBag.Message != null)
{
    <div class="alert alert-success">@ViewBag.Message</div>
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Id" />

    <div class="form-group mb-3">
        <label asp-for="AvailableAmount" class="control-label">Money Available for Review Session</label>
        <input asp-for="AvailableAmount" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="AvailableAmount" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="RolloverAmount" class="control-label">Money Left Over From Last Session</label>
        <input asp-for="RolloverAmount" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="RolloverAmount" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="CutoffPercent" class="control-label">Cutoff Percent</label>
        <input asp-for="CutoffPercent" class="form-control" type="number" step="0.01" min="0" max="100" />
        <span asp-validation-for="CutoffPercent" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Allocations</button>
</form>