@model CS4760GrantApplication.Models.Grant
@{
    ViewData["Title"] = "Review Grant";

    // Option 3 - Access ID directly from route
    var grantId = Context.Request.RouteValues["id"];
}

<div class="container mt-4">
    <h2>Grant Reviews</h2>

    <div class="alert alert-info">
        Reviews for Grant ID: <strong>@grantId</strong>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            General Information
        </div>
        <div class="card-body">

            <div class="mb-3">
                <label class="fw-bold">Title</label>
                <div>@Model.Title</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Description</label>
                <div>@Model.Description</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Project Summary</label>
                <div>@Model.ProjectSummary</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Justification</label>
                <div>@Model.Justification</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Project Impact</label>
                <div>@Model.ProjectImpact</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Project Timeline</label>
                <div>@Model.ProjectTimeline</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">Success Evaluation</label>
                <div>@Model.SuccessEvaluation</div>
            </div>

        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Organization Information
        </div>
        <div class="card-body">

            <div class="mb-3">
                <label class="fw-bold">Multiple Departments</label>
                <div>@(Model.isMultipleDepartments ? "Yes" : "No")</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">College</label>
                <div>@Model.College?.Name</div>
            </div>

            <div class="mb-3">
                <label class="fw-bold">User</label>
                <div>@Model.User?.FirstName @Model.User?.LastName</div>
            </div>

        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Compliance
        </div>
        <div class="card-body">

            <div class="mb-2">
                <strong>Human or Animal Subjects:</strong>
                @(Model.InvolvesHumanOrAnimalSubjects ? "Yes" : "No")
            </div>

            <div class="mb-2">
                <strong>Acknowledgement 1:</strong>
                @(Model.Acknowledgement1 ? "Accepted" : "Not Accepted")
            </div>

            <div class="mb-2">
                <strong>Acknowledgement 2:</strong>
                @(Model.Acknowledgement2 ? "Accepted" : "Not Accepted")
            </div>

            <div class="mb-2">
                <strong>Acknowledgement 3:</strong>
                @(Model.Acknowledgement3 ? "Accepted" : "Not Accepted")
            </div>

            <div class="mb-2">
                <strong>Acknowledgement 4:</strong>
                @(Model.Acknowledgement4 ? "Accepted" : "Not Accepted")
            </div>

        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Signature
        </div>
        <div class="card-body">

            <div class="mb-2">
                <strong>Signature:</strong>
                @Model.Signature
            </div>

            <div class="mb-2">
                <strong>Signature Date:</strong>
                @Model.SignatureDate.ToString("MM/dd/yyyy")
            </div>

        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Status Information
        </div>
        <div class="card-body">

            <div class="mb-2">
                <strong>Draft Saved:</strong>
                @(Model.IsSaved ? "No" : "Yes")
            </div>

            <div class="mb-2">
                <strong>Department Review Status:</strong>
                @(Model.DeptReviewStatus == null
                    ? "Pending"
                    : Model.DeptReviewStatus.Value
                        ? "Approved"
                        : "Rejected")
            </div>

        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Departments
        </div>
        <div class="card-body">

            @if (Model.Departments.Any())
            {
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Department</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dept in Model.Departments)
                        {
                            <tr>
                                <td>@dept.DepartmentName</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No departments assigned.</p>
            }

        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Budget Items
        </div>
        <div class="card-body">

            @if (Model.BudgetItems.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Description</th>
                            <th>Funding Source</th>
                            <th>Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.BudgetItems)
                        {
                            <tr>
                                <td>@item.Description</td>
                                <td>@item.FundingSource</td>
                                <td>@item.Amount.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No budget items.</p>
            }

        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            Attachments
        </div>
        <div class="card-body">

            @if (Model.Attachments.Any())
            {
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>File Name</th>
                            <th>Type</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var attachment in Model.Attachments)
                        {
                            <tr>
                                <td>@attachment.FileName</td>
                                <td>
                                    @(attachment.IsApprovalFile
                                        ? "Approval Document"
                                        : "Supporting Document")
                                </td>
                                <td>
                                    <a asp-controller="Review"
                                       asp-action="DownloadAttachment"
                                       asp-route-id="@attachment.Id"
                                       class="btn btn-primary btn-sm">
                                        Download
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p>No attachments uploaded.</p>
            }

        </div>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Review Notes</label>

        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews)
            {
                <div class="border rounded p-2 mb-2 bg-light">
                    @review.Notes
                </div>
            }
        }
        else
        {
            <p class="text-muted">No review notes available.</p>
        }
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Review Scores</label>

        @if (Model.Reviews != null && Model.Reviews.Any())
        {
            @foreach (var review in Model.Reviews)
            {
                @if(review.User != null) {
                <div class="border rounded p-2 mb-2 bg-light">
                    @review.AverageScore given by @review.User.FirstName @review.User.LastName
                </div>
                }
            }
        }
        else
        {
            <p class="text-muted">No review scores available.</p>
        }
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>