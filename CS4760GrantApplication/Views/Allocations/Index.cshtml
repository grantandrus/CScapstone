@model CS4760GrantApplication.ViewModels.AllocationsViewModel
@{
    ViewData["Title"] = "Allocations";
}
@{
    decimal AllRequestedFundsARCC = 0;
}

<h1 class="display-6 mb-4">Allocations</h1>

<div class="row mb-4">

    <div class="col-lg-4 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">

                <small class="text-muted text-uppercase">
                    Total Requested
                </small>

                <h2 class="mt-2">
                    @AllRequestedFundsARCC.ToString("C")
                </h2>

            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-3">
        <div class="card shadow-sm h-100">
            <div class="card-body">

                <small class="text-muted text-uppercase">
                    Total Available
                </small>

                <h2 class="mt-2">
                    @Model.Allocation.AvailableAmount.ToString("C")
                </h2>

            </div>
        </div>
    </div>

    <div class="col-lg-4 mb-3">
        <div class="card shadow-sm h-100">

            <div class="card-body">

                <small class="text-muted text-uppercase">
                    Remaining After Rollover
                </small>

                <h2 class="mt-2">
                    @Model.Allocation.RolloverAmount.ToString("C")
                </h2>

            </div>

        </div>
    </div>

</div>

<ul class="nav nav-tabs mb-4" id="allocationTabs" role="tablist">

    <li class="nav-item">

        <button class="nav-link active"
                data-bs-toggle="tab"
                data-bs-target="#settings">

            Available Funds

        </button>

    </li>

    <li class="nav-item">

        <button class="nav-link"
                data-bs-toggle="tab"
                data-bs-target="#rules">

            Rule Management

        </button>

    </li>

    <li class="nav-item">

        <button class="nav-link"
                data-bs-toggle="tab"
                data-bs-target="#grants">

            View Grants

        </button>

    </li>

</ul>

<div class="tab-content">

    <div class="tab-pane fade show active"
         id="settings"
        role="tabpanel">

        <div class="card shadow-sm">

            <div class="card-header">

                <h4 class="mb-0">
                    Allocation Settings
                </h4>

            </div>

            <div class="card-body">

                
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <input type="hidden" asp-for="Allocation.Id" />

                    <div class="row">
                        <div class="col-md-4">
                            <label asp-for="Allocation.AvailableAmount" class="control-label">Money Available for Review Session</label>
                            <input asp-for="Allocation.AvailableAmount" class="form-control allocation-field" disabled type="number" step="0.01" min="0" />
                            <span asp-validation-for="Allocation.AvailableAmount" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Allocation.RolloverAmount" class="control-label">Money Left Over From Last Session</label>
                            <input asp-for="Allocation.RolloverAmount" class="form-control allocation-field" disabled type="number" step="0.01" min="0" />
                            <span asp-validation-for="Allocation.RolloverAmount" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Allocation.CutoffPercent" class="control-label">Cutoff Percent</label>
                            <div class="input-group">
                                <input asp-for="Allocation.CutoffPercent" class="form-control allocation-field" disabled type="number" step="1" min="0" max="100" style="width: 80px;" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Allocation.CutoffPercent" class="text-danger"></span>
                        </div>

                    </div>
                    

                    <div class="mt-4 d-flex justify-content-end">

                        <button type="button"
                                id="editButton"
                                class="btn btn-secondary">
                            Edit
                        </button>

                        <button type="submit"
                                id="saveButton"
                                class="btn btn-primary"
                                style="display:none;">
                            Save
                        </button>

                    </div>
                </form>


            </div>

        </div>

    </div>

    <div class="tab-pane fade"
         id="rules"
        role="tabpanel">

        <div class="row">

            <div class="col-lg-8">

                <div class="card shadow-sm mb-4">

                    <div class="card-header d-flex justify-content-between align-items-center">

                        <h4 class="mb-0">

                            Allocation Rules

                        </h4>

                        <span class="badge bg-secondary">

                            @Model.Rules.Count Rule(s)

                        </span>

                    </div>

                    <div class="card-body p-0">

                        <div class="table-responsive">

                            <table class="table table-hover mb-0 align-middle">

                                <thead class="table-light">

                                    <tr>

                                        <th>Score Range</th>
                                        <th>Percent</th>
                                        <th></th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var rule in Model.Rules.OrderByDescending(r => r.MinScore))
                                    {
                                        <tr>
                                            <td>
                                                @rule.MinScore - @rule.MaxScore
                                            </td>

                                            <td>
                                                @rule.PercentAllocated%
                                            </td>

                                            <td class="text-end">

                                                <form asp-action="RemoveRule"
                                                      asp-route-id="@rule.Id"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <button class="btn btn-outline-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                </form>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </div>

                </div>

            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm">

                    <div class="card-header">

                        <h5 class="mb-0">

                            Add Allocation Rule

                        </h5>

                    </div>

                    <div class="card-body">

                        
                        <form asp-action="AddRule" method="post">

                            <label>From</label>

                            <div class="input-group mb-2" style="width:110px;">
                                <input asp-for="NewRule.MinScore"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="1" />
                                <span class="input-group-text">%</span>
                            </div>


                            <label>To</label>

                            <div class="input-group mb-2" style="width:110px;">
                                <input asp-for="NewRule.MaxScore"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="1" />
                                <span class="input-group-text">%</span>
                            </div>


                            <label>Percent Allocated</label>

                            <div class="input-group mb-2" style="width:110px;">
                                <input asp-for="NewRule.PercentAllocated"
                                       class="form-control"
                                       type="number"
                                       min="0"
                                       max="100"
                                       step="1" />
                                <span class="input-group-text">%</span>
                            </div>


                            <button class="btn btn-success">

                                <i class="bi bi-plus-circle"></i>

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

        <div class="border-top p-3 text-end">

            <button class="btn btn-success"
                    id="previewRulesButton">

                Preview Allocation

            </button>

        </div>

    </div>

    <div class="tab-pane fade"
         id="grants"
        role="tabpanel">

        <div class="card shadow-sm">

            <div class="card-header d-flex justify-content-between align-items-center">

                <div>

                    <h4 class="mb-0">
                        Available Grants
                    </h4>

                    <small class="text-muted">
                        Grants that have been reviewed and are awaiting ARCC allocation decisions.
                    </small>

                </div>

                <button class="btn btn-primary"
                        id="previewCutoffButton">

                    Preview Cutoff

                </button>

            </div>

            <div class="card-body">

                <ul class="nav nav-pills mb-4">

                    <li class="nav-item">
                        <button class="nav-link active"
                                data-bs-toggle="pill"
                                data-bs-target="#undecidedGrants">

                            Pending
                        </button>
                    </li>

                    <li class="nav-item">
                        <button class="nav-link"
                                data-bs-toggle="pill"
                                data-bs-target="#acceptedGrants">

                            Accepted

                            <span class="badge bg-success ms-1">
                                @Model.AcceptedGrants.Count
                            </span>

                        </button>

                    </li>

                    <li class="nav-item">

                        <button class="nav-link"
                                data-bs-toggle="pill"
                                data-bs-target="#rejectedGrants">

                            Rejected

                            <span class="badge bg-danger ms-1">
                                @Model.RejectedGrants.Count
                            </span>

                        </button>

                    </li>

                </ul>
                <div class="tab-content">
                    <div class="tab-pane fade show active" id="undecidedGrants" role="tabpanel">
                        @if(Model.UndecidedGrants.Count > 0){
                        <div class="d-flex justify-content-between">
                            <h2 style="font-size:1.5rem" class="mt-4 mb-3">Grants Awaiting Approval</h2>
                            <form asp-action="ApplyCutoff" method="post">
                                @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-primary d-none">Apply Cutoff</button>
                            </form>
                        </div>

                        <table class="table">
                            <thead>
                                <tr>
                                    <th>
                                        Grant Title
                                    </th>
                                    <th>
                                        Project Director
                                    </th>
                                    <th>
                                        ARCC Requested Funds 
                                    </th>
                                    <th>
                                        Total Requested Funds
                                    </th>
                                    <th>
                                        Aggregate Review Score
                                    </th>
                                    <th>
                                        Notes
                                    </th>
                                    <th>
                                        View
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.UndecidedGrants)
                                {
                                    <tr>
                                        <td>
                                            @item.Title
                                        </td>
                                        <td>
                                            @(item.User.FirstName + " " + item.User.LastName)
                                        </td>
                                        <td>
                                            @{
                                                decimal arccTotal = 0;
                                            }
                                            @foreach (var budgetItem in item.BudgetItems)
                                            {
                                                @if (budgetItem.FundingSource == "ARCC")
                                                {

                                                    arccTotal += budgetItem.Amount;
                                                    AllRequestedFundsARCC += arccTotal;
                                                }
                                            }
                                            @arccTotal
                                        </td>
                                        <td>
                                            @{
                                                decimal total = 0;
                                            }
                                            @foreach (var budgetItem in item.BudgetItems)
                                            {
                                                total += budgetItem.Amount;
                                            }
                                            @total
                                        </td>
                                        @if (item.Reviews.Count() != 0)
                                        {
                                            decimal totalScore = 0;
                                            @foreach (var review in item.Reviews)
                                            {
                                                totalScore += review.AverageScore;
                                            }
                                            decimal averageScore = totalScore / item.Reviews.Count();
                                            <td>
                                                @Math.Round(averageScore, 2)
                                            </td>
                                        } else
                                        {
                                            <td>
                                                Awaiting Review
                                            </td>
                                        }
                                        <td>
                                            @if (item.Reviews.Count() != 0)
                                            {
                                                    foreach (var review in item.Reviews)
                                                    {
                                                        if (review.Notes != null)
                                                        {
                                                            <form asp-controller="Allocations"
                                                            asp-action="Notes"
                                                            asp-route-id="@item.Id"
                                                            method="get">
                                                                <button type="submit" class="btn btn-primary">
                                                                    View Notes
                                                                </button>
                                                            </form>
                                                            break;
                                                        }
                                                        else
                                                        {
                                                            <div class="text-secondary" style="font-style:italic;">No Notes</div>
                                                        }
                                                    }
                                                }
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("View", "Allocations", new { id = item.Id })'">View</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>}
                        else{
                        <div class="text-secondary" style="font-style:italic;">No grants awaiting approval.</div>
                        }
                    </div>

                    <div class="tab-pane fade" id="acceptedGrants" role="tabpanel">
                        @if(Model.AcceptedGrants.Count() > 0){
                        <h2 style="font-size:1.5rem" class="mt-4 mb-3">Accepted Grants</h2>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>
                                        Grant Title
                                    </th>
                                    <th>
                                        Project Director
                                    </th>
                                    <th>
                                        ARCC Requested Funds
                                    </th>
                                    <th>
                                        Total Requested Funds
                                    </th>
                                    <th>
                                        Aggregate Review Score
                                    </th>
                                    <th>
                                        Notes
                                    </th>
                                    <th>
                                        Allocated Funds
                                    </th>
                                    <th>
                                        View
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.AcceptedGrants)
                                {
                                    <tr>
                                        <td>
                                            @item.Title
                                        </td>
                                        <td>
                                            @(item.User.FirstName + " " + item.User.LastName)
                                        </td>
                                        <td>
                                            @{
                                                decimal arccTotal = 0;
                                            }
                                            @foreach (var budgetItem in item.BudgetItems)
                                            {
                                                @if (budgetItem.FundingSource == "ARCC")
                                                {

                                                    arccTotal += budgetItem.Amount;
                                                        AllRequestedFundsARCC += arccTotal;

                                                }
                                            }
                                            @arccTotal
                                        </td>
                                        <td>
                                            @{
                                                decimal total = 0;
                                            }
                                            @foreach (var budgetItem in item.BudgetItems)
                                            {
                                                total += budgetItem.Amount;
                                            }
                                            @total
                                        </td>
                                        @if (item.Reviews.Count() != 0)
                                        {
                                            decimal totalScore = 0;
                                            @foreach (var review in item.Reviews)
                                            {
                                                totalScore += review.AverageScore;
                                            }
                                            decimal averageScore = totalScore / item.Reviews.Count();
                                            <td>
                                                @Math.Round(averageScore, 2)
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                Awaiting Review
                                            </td>
                                        }
                                            <td>
                                                @if (item.Reviews.Count() != 0)
                                                {
                                                    foreach (var review in item.Reviews)
                                                    {
                                                        if (review.Notes != null)
                                                        {
                                                            <form asp-controller="Allocations"
                                                                  asp-action="Notes"
                                                                  asp-route-id="@item.Id"
                                                                  method="get">
                                                                <button type="submit" class="btn btn-primary">
                                                                    View Notes
                                                                </button>
                                                            </form>
                                                            break;
                                                        }
                                                        else
                                                        {
                                                            <div class="text-secondary" style="font-style:italic;">No Notes</div>
                                                        }
                                                    }
                                                }
                                            </td>
                                        <td>
                                            @item.AllocatedFunds
                                        </td>
                                        <td>
                                            <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("View", "Allocations", new { id = item.Id })'">View</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        }
                        else
                        {
                            <div class="text-secondary" style="font-style:italic;">No accepted grants.</div>
                        }
                    </div>

                    <div class="tab-pane fade" id="rejectedGrants" role="tabpanel">
                        
                        @if(Model.RejectedGrants.Count() > 0){
                            <h2 style="font-size:1.5rem" class="mt-4 mb-3">Rejected Grants</h2>
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>
                                        Grant Title
                                    </th>
                                    <th>
                                        Project Director
                                    </th>
                                    <th>
                                        ARCC Requested Funds
                                    </th>
                                    <th>
                                        Total Requested Funds
                                    </th>
                                    <th>
                                        Aggregate Review Score
                                    </th>
                                    <th>
                                        Notes
                                    </th>
                                    <th>
                                        View
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.RejectedGrants)
                                {
                                    <tr>
                                        <td>
                                            @item.Title
                                        </td>
                                        <td>
                                            @(item.User.FirstName + " " + item.User.LastName)
                                        </td>
                                        <td>
                                            @{
                                                decimal arccTotal = 0;
                                            }
                                            @foreach (var budgetItem in item.BudgetItems)
                                            {
                                                @if (budgetItem.FundingSource == "ARCC")
                                                {

                                                    arccTotal += budgetItem.Amount;
                                                    AllRequestedFundsARCC += arccTotal;
                                                }
                                            }
                                            @arccTotal
                                        </td>
                                        <td>
                                            @{
                                                decimal total = 0;
                                            }
                                            @foreach (var budgetItem in item.BudgetItems)
                                            {
                                                total += budgetItem.Amount;
                                            }
                                            @total
                                        </td>
                                        @if (item.Reviews.Count() != 0)
                                        {
                                            decimal totalScore = 0;
                                            @foreach (var review in item.Reviews)
                                            {
                                                totalScore += review.AverageScore;
                                            }
                                            decimal averageScore = totalScore / item.Reviews.Count();
                                            <td>
                                                @Math.Round(averageScore, 2)
                                            </td>
                                        }
                                        else
                                        {
                                            <td>
                                                Awaiting Review
                                            </td>
                                        }
                                            <td>
                                                @if (item.Reviews.Count() != 0)
                                                {
                                                    foreach (var review in item.Reviews)
                                                    {
                                                        if (review.Notes != null)
                                                        {
                                                            <form asp-controller="Allocations"
                                                                  asp-action="Notes"
                                                                  asp-route-id="@item.Id"
                                                                  method="get">
                                                                <button type="submit" class="btn btn-primary">
                                                                    View Notes
                                                                </button>
                                                            </form>
                                                            break;
                                                        }
                                                        else
                                                        {
                                                            <div class="text-secondary" style="font-style:italic;">No Notes</div>
                                                        }
                                                    }
                                                }
                                            </td>
                                        <td>
                                            <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("View", "Allocations", new { id = item.Id })'">View</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        }
                        else
                        {
                            <div class="text-secondary" style="font-style:italic;">No rejected grants.</div>
                        }
                    </div>
                </div>
            </div>

        </div>

    </div>

</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}


<br /><br />

<div class="d-flex gap-2">

    <form method="post"
          asp-controller="Allocations"
          asp-action="CompleteAllocations"
          onsubmit="return confirm('Are you sure you want to complete the allocations? This action cannot be easily undone.');">

        <input type="submit"
               value="Complete Allocations"
               class="btn btn-warning" />
    </form>

    <form method="post"
          asp-controller="Allocations"
          asp-action="Export">
        <input type="submit"
               value="Send to Accounting"
               class="btn btn-primary" />
    </form>

</div>

<div class="modal fade"
     id="allocationPreviewModal"
     tabindex="-1"
     aria-labelledby="allocationPreviewLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>
                    <h4 class="modal-title" id="allocationPreviewLabel">
                        Allocation Preview
                    </h4>

                    <small class="text-muted">
                        Review the projected grant allocations before applying the rules.
                    </small>
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <div class="row mb-4">

                    <div class="col-md-3">

                        <div class="card border-0 bg-light">

                            <div class="card-body text-center">

                                <small class="text-muted">
                                    Total Requested
                                </small>

                                <h4 id="previewRequested">$0.00</h4>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="card border-0 bg-light">

                            <div class="card-body text-center">

                                <small class="text-muted">
                                    Total Allocated
                                </small>

                                <h4 id="previewAllocated">$0.00</h4>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="card border-0 bg-light">

                            <div class="card-body text-center">

                                <small class="text-muted">
                                    Available Funds
                                </small>

                                <h4 id="previewAvailable">$0.00</h4>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <div class="card border-0 bg-light">

                            <div class="card-body text-center">

                                <small class="text-muted">
                                    Remaining
                                </small>

                                <h4 id="previewRemaining">$0.00</h4>

                            </div>

                        </div>

                    </div>

                </div>

                <div id="allocationWarnings"></div>

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>Grant</th>

                                <th>PI</th>

                                <th class="text-center">
                                    Score
                                </th>

                                <th class="text-end">
                                    Requested
                                </th>

                                <th class="text-center">
                                    Allocation %
                                </th>

                                <th class="text-end">
                                    Award
                                </th>

                            </tr>

                        </thead>

                        <tbody id="allocationPreviewTable">
                        </tbody>

                    </table>

                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <form asp-action="ApplyRules"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button id="confirmAllocationButton"
                            type="submit"
                            class="btn btn-success">

                        Confirm Allocation

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<div class="modal fade"
     id="cutoffPreviewModal"
     tabindex="-1">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <div>

                    <h4 class="modal-title">

                        Cutoff Preview

                    </h4>

                    <small class="text-muted">

                        Review the grants that will be affected before applying the cutoff.

                    </small>

                </div>

                <button class="btn-close"
                        data-bs-dismiss="modal"></button>

            </div>

            <div class="modal-body">

                <div class="row mb-4">

                    <div class="col-md-4">

                        <div class="card border-success shadow-sm h-100">

                            <div class="card-body text-center">

                                <small class="text-muted text-uppercase">
                                    Accepted
                                </small>

                                <h2 class="text-success mt-2"
                                    id="previewAcceptedCount">

                                    0

                                </h2>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="card border-danger shadow-sm h-100">

                            <div class="card-body text-center">

                                <small class="text-muted text-uppercase">
                                    Rejected
                                </small>

                                <h2 class="text-danger mt-2"
                                    id="previewRejectedCount">

                                    0

                                </h2>

                            </div>

                        </div>

                    </div>

                    <div class="col-md-4">

                        <div class="card border-primary shadow-sm h-100">

                            <div class="card-body text-center">

                                <small class="text-muted text-uppercase">
                                    Total Affected
                                </small>

                                <h2 class="text-primary mt-2"
                                    id="previewAffectedCount">

                                    0

                                </h2>

                            </div>

                        </div>

                    </div>

                </div>
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>

                                <th>Grant</th>

                                <th>Principal Investigator</th>

                                <th class="text-center">
                                    Average Score
                                </th>

                                <th class="text-center">
                                    Cutoff
                                </th>

                                <th class="text-center">
                                    New Status
                                </th>

                            </tr>

                        </thead>

                        <tbody id="cutoffPreviewTable">
                        </tbody>

                    </table>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <form asp-action="ApplyCutoff"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button class="btn btn-primary">

                        Confirm Cutoff

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
<script>
    document.getElementById("editButton").addEventListener("click", function () {

        document.querySelectorAll(".allocation-field")
            .forEach(field => {
                field.disabled = false;
            });

        const applyCutoffButton = document.getElementById("applyCutoffButton");
        if (applyCutoffButton) {
            applyCutoffButton.disabled = true;
        }

        const applyRulesBtn = document.getElementById("apply-rules-btn");
        if (applyRulesBtn) {
            applyRulesBtn.disabled = true;
        }

        document.getElementById("editButton").style.display = "none";
        
        const saveButton = document.getElementById("saveButton");
        if (saveButton) {
            saveButton.style.display = "";
        }
    });

    document.getElementById("previewCutoffButton")?.addEventListener("click", function (e) {
        e.preventDefault();
        fetch('@Url.Action("PreviewCutoffData", "Allocations")')
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                } else {
                    populateCutoffPreview(data);
                    new bootstrap.Modal(document.getElementById('cutoffPreviewModal')).show();
                }
            })
            .catch(err => console.error('Error fetching cutoff preview:', err));
    });

    document.getElementById("previewRulesButton")?.addEventListener("click", function (e) {
        e.preventDefault();
        fetch('@Url.Action("PreviewAllocationData", "Allocations")')
            .then(response => response.json())
            .then(data => {
                if (data.error) {
                    alert(data.error);
                } else {
                    populateAllocationPreview(data);
                }
            })
            .catch(err => console.error('Error fetching allocation preview:', err));
    });

            function populateAllocationPreview(data) {

            $("#previewRequested").text(data.totalRequestedFormatted);
            $("#previewAllocated").text(data.totalAllocatedFormatted);
            $("#previewAvailable").text(data.availableFundsFormatted);
            $("#previewRemaining").text(data.remainingFundsFormatted);

            let tbody = $("#allocationPreviewTable");

            tbody.empty();

            data.grants.forEach(g => {

                tbody.append(`
                    <tr>

                        <td>${g.title}</td>

                        <td>${g.principalInvestigator}</td>

                        <td class="text-center">
                            ${g.averageScore.toFixed(1)}
                        </td>

                        <td class="text-end">
                            ${g.requestedAmountFormatted}
                        </td>

                        <td class="text-center">
                            ${g.percentAllocated}%'
                        </td>

                        <td class="text-end fw-bold">
                            ${g.allocatedAmountFormatted}
                        </td>

                    </tr>
                `);

            });

            renderWarnings(data);

            $("#confirmAllocationButton")
                .prop("disabled", data.isOverAllocated);

            new bootstrap.Modal(
                document.getElementById("allocationPreviewModal")
            ).show();

        }

                function renderWarnings(data) {

            const warningArea = $("#allocationWarnings");

            warningArea.empty();

            if (data.isOverAllocated) {

                warningArea.append(`

                    <div class="alert alert-danger">

                        <strong>Allocation exceeds available funds.</strong>

                        Adjust the allocation rules before continuing.

                    </div>
                `);

                return;
            }

            if (data.isLargeRemainder) {

                warningArea.append(`

                    <div class="alert alert-warning">

                        <strong>Notice:</strong>

                        More than $5,000 will remain unallocated.

                        You may still continue.

                    </div>
                `);

            }
            else {

                warningArea.append(`

                    <div class="alert alert-success">

                        Allocation is within the available budget.

                    </div>
                `);

            }

        }
        
        function populateCutoffPreview(data) {

            $("#previewAcceptedCount").text(data.acceptedCount);

            $("#previewRejectedCount").text(data.rejectedCount);

            $("#previewAffectedCount").text(data.affectedCount);

            const tbody = $("#cutoffPreviewTable");

            tbody.empty();

            data.grants.forEach(g => {

                let badge =
                    g.accept
                    ? '<span class="badge bg-success">Accepted</span>'
                    : '<span class="badge bg-danger">Rejected</span>';

                tbody.append(`

                    <tr>

                        <td>${g.title}</td>

                        <td>${g.principalInvestigator}</td>

                        <td class="text-center">
                            ${g.averageScore.toFixed(1)}%
                        </td>

                        <td class="text-center">
                            ${data.cutoff.toFixed(1)}%
                        </td>

                        <td class="text-center">
                            ${badge}
                        </td>

                    </tr>
                `);

            });

        }
</script>
}