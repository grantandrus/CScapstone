<br /><br />

<div class="card mt-3">
    <div class="card-body">
        <h5 class="card-title mb-2">Total Funds Requested From ARCC</h5>
        <p class="card-text fs-5 fw-bold mb-0">
            @AllRequestedFundsARCC.ToString("C")
        </p>
    </div>
</div>

<div class="d-flex gap-2">

    <form method="post"
          asp-controller="Allocations"
          asp-action="Export">
        <input type="submit"
               value="Send to Accounting"
               class="btn btn-primary" />
    </form>

    <form method="post"
          asp-controller="Allocations"
          asp-action="CompleteAllocations"
          onsubmit="return confirm('Are you sure you want to complete the allocations? This action cannot be easily undone.');">

        <input type="submit"
               value="Complete Allocations"
               class="btn btn-warning" />
    </form>

</div>

@section Scripts
{
<script>
    document.getElementById("editButton").addEventListener("click", function () {

        document.querySelectorAll(".allocation-field")
            .forEach(field => {
                field.disabled = false;
            });

        document.getElementById("applyCutoffButton").disabled = true;
        document.getElementById("editButton").style.display = "none";
        document.getElementById("saveButton").style.display = "";
    });
</script>s
}