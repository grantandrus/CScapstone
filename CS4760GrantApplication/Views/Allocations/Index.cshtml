@model CS4760GrantApplication.ViewModels.AllocationsViewModel
@{
    ViewData["Title"] = "Allocations";
}


<h1>Allocations</h1>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <input type="hidden" asp-for="Allocation.Id" />

    <div class="form-group mb-3">
        <label asp-for="Allocation.AvailableAmount" class="control-label">Money Available for Review Session</label>
        <input asp-for="Allocation.AvailableAmount" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Allocation.AvailableAmount" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Allocation.RolloverAmount" class="control-label">Money Left Over From Last Session</label>
        <input asp-for="Allocation.RolloverAmount" class="form-control" type="number" step="0.01" min="0" />
        <span asp-validation-for="Allocation.RolloverAmount" class="text-danger"></span>
    </div>

    <div class="form-group mb-3">
        <label asp-for="Allocation.CutoffPercent" class="control-label">Cutoff Percent</label>
        <input asp-for="Allocation.CutoffPercent" class="form-control" type="number" step="0.01" min="0" max="100" />
        <span asp-validation-for="Allocation.CutoffPercent" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Allocations</button>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                Grant Title
            </th>
            <th>
                Project Director
            </th>
            <th>
                Requested Funds
            </th>
            <th>
                Aggregate Review Score
            </th>
            <th>
                Notes
            </th>
            <th>
                View
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Grants)
        {
            <tr>
                <td>
                    @item.Title
                </td>
                <td>
                    @(item.User.FirstName + " " + item.User.LastName)
                </td>
                <td>
                    @{
                        decimal total = 0;
                    }
                    @foreach (var budgetItem in item.BudgetItems)
                    {
                        @if (budgetItem.FundingSource == "ARCC")
                        {

                            total += budgetItem.Amount;

                        }
                    }
                    @total
                </td>
                @if (item.Reviews.Count() != 0)
                {
                    decimal totalScore = 0;
                    @foreach (var review in item.Reviews)
                    {
                        totalScore += review.AverageScore;
                    }
                    decimal averageScore = totalScore / item.Reviews.Count();
                    <td>
                        @Math.Round(averageScore, 2)
                    </td>
                } else
                {
                    <td>
                        Awaiting Review
                    </td>
                }
                <td>
                    @if(item.DeptReviewNotes != "")
                    {
                        <div>@item.DeptReviewNotes</div>
                    } 
                    @if(item.DeptReviewNotes != "" && item.CollegeReviewNotes != "")
                    {
                        <hr/>
                    }
                    @if(item.CollegeReviewNotes != "")
                    {
                        <div>@item.CollegeReviewNotes</div>   
                    }
                    @if (item.DeptReviewNotes == "" && item.CollegeReviewNotes == "")
                    {
                        //different styling to differentiate between system message vs if a user inputted 'No Notes'
                        <div class="text-secondary" style="font-style:italic;">No Notes</div>
                    }

                </td>
                <td>
                    <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("View", "Allocations", new { id = item.Id })'">View</button>
                </td>
            </tr>
        }
    </tbody>
</table>
