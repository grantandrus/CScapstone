@using CS4760GrantApplication.Models
@{
    var userId = Context.Session.GetInt32("UserID");
    var userRole = Context.Session.GetString("UserRole");
    var isCommitteeChair = Context.Session.GetString("IsCommitteeChair") == "True";
    var isCommitteMember = Context.Session.GetString("IsCommitteMember") == "True";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CS4760GrantApplication</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CS4760GrantApplication.styles.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="https://jsdelivr.net" /> *@
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm mb-4">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-semibold me-4"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Grant Applications
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-area=""
                               asp-controller="Dashboard"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        @if (userId.HasValue && userRole == "admin")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="College"
                                   asp-action="Index">
                                    Colleges
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Departments"
                                   asp-action="Index">
                                    Departments
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="ARCC"
                                   asp-action="Index">
                                    ARCC Committee
                                </a>
                            </li>
                        }

                        @if (userId.HasValue && isCommitteMember)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Review"
                                   asp-action="Index">
                                    Review Grants
                                </a>
                            </li>
                        }

                        @if (userId.HasValue && isCommitteeChair)
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-area=""
                                   asp-controller="Rubric"
                                   asp-action="Create">
                                    Rubric Management
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Allocations"
                                   asp-action="Index">
                                    Allocations
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-lg-center">
                        @if (userId.HasValue)
                        {
                            <li class="nav-item">
                                <span class="navbar-text user-summary">
                                    @Context.Session.GetString("Name")
                                    <span class="user-role">
                                        @Context.Session.GetString("UserRole")
                                    </span>
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Users"
                                   asp-action="Index">
                                    Profile
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Users"
                                   asp-action="Logout">
                                    Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Users"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="btn btn-primary ms-lg-2"
                                   asp-controller="Users"
                                   asp-action="Create">
                                    Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CS4760GrantApplication - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
