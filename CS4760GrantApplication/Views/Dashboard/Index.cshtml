@model CS4760GrantApplication.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-section {
        margin-top: 2.5rem;
    }

    .dashboard-table {
        width: 100%;
        margin-bottom: 0;
        table-layout: fixed;
    }

    .dashboard-table th {
        vertical-align: middle;
        text-align: center;
        white-space: normal;
        line-height: 1.2;
        padding-top: 0.9rem;
        padding-bottom: 0.9rem;
    }

    .dashboard-table th:nth-child(6),
.dashboard-table th:nth-child(7),
.dashboard-table th:nth-child(8),
.dashboard-table th:nth-child(9) {
    min-width: 120px;
}

    .dashboard-table td {
        vertical-align: middle;
        overflow-wrap: anywhere;
    }

    .dashboard-table .text-column {
        white-space: normal;
        overflow-wrap: anywhere;
    }

    .dashboard-table .status-column {
        white-space: normal;
    }

    .dashboard-table .actions-column .btn {
        width: 100%;
        white-space: nowrap;
    }

    .dashboard-table-container {
        margin-bottom: 2rem;
        border: 1px solid var(--bs-border-color);
        border-radius: 0.5rem;
        overflow: hidden;
    }

    .dashboard-empty-state {
        padding: 1.5rem;
        margin-bottom: 0;
        color: var(--bs-secondary-color);
        text-align: center;
        background-color: var(--bs-tertiary-bg);
    }

    .section-heading {
        margin-bottom: 1rem;
    }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
    <h1 class="mb-0">Your Grants</h1>

    <a class="btn btn-primary"
       asp-controller="Grant"
       asp-action="Create">
        <i class="bi bi-plus-circle me-1"></i>
        Create Grant
    </a>
</div>

<div class="mb-4">
    <button class="btn btn-outline-primary"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#notificationPanel"
            aria-expanded="false"
            aria-controls="notificationPanel">
        <i class="bi bi-bell-fill me-1"></i>
        Notifications

        @if (Model.Notifications.Any())
        {
            <span class="badge bg-danger ms-1">
                @Model.Notifications.Count
            </span>
        }
    </button>

    <div class="collapse mt-2" id="notificationPanel">
        <div class="card shadow-sm">
            <div class="card-body">
                @if (Model.Notifications.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var notification in Model.Notifications)
                        {
                            <div class="list-group-item px-0">
                                @notification.Message
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="mb-0 text-muted">
                        No notifications.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<section class="dashboard-section">
    <h2 class="section-heading">Edit Grants</h2>

    @{
        var savedGrants = Model.MyGrants
            .Where(g => g.IsSaved)
            .ToList();
    }

    @if (savedGrants.Any())
    {
        <div class="table-responsive dashboard-table-container">
            <table class="table table-striped table-hover align-middle dashboard-table">
                <thead class="table-light">
                    <tr>
                        <th>Grant Title</th>
                        <th>Description</th>
                        <th>Project Summary</th>
                        <th>Justification</th>
                        <th>Project Impact</th>
                        <th>Multiple Departments</th>
                        <th>College</th>
                        <th>Department Name</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in savedGrants)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Title</td>
                            <td class="text-column">@item.Description</td>
                            <td class="text-column">@item.ProjectSummary</td>
                            <td class="text-column">@item.Justification</td>
                            <td>@item.ProjectImpact</td>
                            <td>
                                @(item.isMultipleDepartments ? "Yes" : "No")
                            </td>
                            <td>
                                @(item.College?.Name ?? "None")
                            </td>
                            <td>
                                @{
                                    var departments = string.Join(
                                        ", ",
                                        item.Departments.Select(d => d.DepartmentName)
                                    );
                                }

                                @(string.IsNullOrWhiteSpace(departments)
                                    ? "None"
                                    : departments)
                            </td>
                            <td class="status-column">
                                @(item.Statuses.Any()
                                    ? string.Join(", ", item.Statuses)
                                    : "Not Reviewed")
                            </td>
                            <td class="actions-column">
                                <div class="d-grid gap-2">
                                    <a class="btn btn-secondary btn-sm"
                                       asp-controller="Grant"
                                       asp-action="Edit"
                                       asp-route-id="@item.Id">
                                        Edit
                                    </a>

                                    <a class="btn btn-danger btn-sm"
                                       asp-controller="Grant"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="dashboard-table-container">
            <p class="dashboard-empty-state">
                You do not currently have any saved grants.
            </p>
        </div>
    }
</section>

<section class="dashboard-section">
    <h2 class="section-heading">Submitted Grants</h2>

    @{
        var submittedGrants = Model.MyGrants
            .Where(g =>
                !g.Statuses.Contains(GrantStatus.RejectedARCC) &&
                !g.Statuses.Contains(GrantStatus.ApprovedARCC) &&
                !g.Statuses.Contains(GrantStatus.ApprovedByDeptChair) &&
                !g.Statuses.Contains(GrantStatus.RejectedByDeptChair) &&
                !g.Statuses.Contains(GrantStatus.ApproveDean) &&
                !g.Statuses.Contains(GrantStatus.RejectedDean) &&
                !g.IsSaved)
            .ToList();
    }

    @if (submittedGrants.Any())
    {
        <div class="table-responsive dashboard-table-container">
            <table class="table table-striped table-hover align-middle dashboard-table">
                <thead class="table-light">
                    <tr>
                        <th>Grant Title</th>
                        <th>Description</th>
                        <th>Project Summary</th>
                        <th>Justification</th>
                        <th>Project Impact</th>
                        <th>Multiple Departments</th>
                        <th>College</th>
                        <th>Department Name</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in submittedGrants)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Title</td>
                            <td class="text-column">@item.Description</td>
                            <td class="text-column">@item.ProjectSummary</td>
                            <td class="text-column">@item.Justification</td>
                            <td>@item.ProjectImpact</td>
                            <td>
                                @(item.isMultipleDepartments ? "Yes" : "No")
                            </td>
                            <td>
                                @(item.College?.Name ?? "None")
                            </td>
                            <td>
                                @{
                                    var departments = string.Join(
                                        ", ",
                                        item.Departments.Select(d => d.DepartmentName)
                                    );
                                }

                                @(string.IsNullOrWhiteSpace(departments)
                                    ? "None"
                                    : departments)
                            </td>
                            <td class="status-column">
                                @(item.Statuses.Any()
                                    ? string.Join(", ", item.Statuses)
                                    : "Not Reviewed")
                            </td>
                            <td class="actions-column">
                                <div class="d-grid">
                                    <a class="btn btn-secondary btn-sm"
                                       asp-controller="Grant"
                                       asp-action="ViewGrant"
                                       asp-route-id="@item.Id">
                                        View
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="dashboard-table-container">
            <p class="dashboard-empty-state">
                You do not currently have any submitted grants.
            </p>
        </div>
    }
</section>

<section class="dashboard-section">
    <h2 class="section-heading">Approved Grants</h2>

    @{
        var approvedGrants = Model.MyGrants
            .Where(g =>
                (
                    g.Statuses.Contains(GrantStatus.ApprovedARCC) ||
                    g.Statuses.Contains(GrantStatus.ApprovedByDeptChair) ||
                    g.Statuses.Contains(GrantStatus.ApproveDean)
                ) &&
                !g.ReportSubmitted)
            .ToList();
    }

    @if (approvedGrants.Any())
    {
        <div class="table-responsive dashboard-table-container">
            <table class="table table-striped table-hover align-middle dashboard-table">
                <thead class="table-light">
                    <tr>
                        <th>Grant Title</th>
                        <th>Description</th>
                        <th>Project Summary</th>
                        <th>Justification</th>
                        <th>Project Impact</th>
                        <th>Multiple Departments</th>
                        <th>College</th>
                        <th>Department Name</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in approvedGrants)
                    {
                        <tr>
                            <td class="fw-semibold">@item.Title</td>
                            <td class="text-column">@item.Description</td>
                            <td class="text-column">@item.ProjectSummary</td>
                            <td class="text-column">@item.Justification</td>
                            <td>@item.ProjectImpact</td>
                            <td>
                                @(item.isMultipleDepartments ? "Yes" : "No")
                            </td>
                            <td>
                                @(item.College?.Name ?? "None")
                            </td>
                            <td>
                                @{
                                    var departments = string.Join(
                                        ", ",
                                        item.Departments.Select(d => d.DepartmentName)
                                    );
                                }

                                @(string.IsNullOrWhiteSpace(departments)
                                    ? "None"
                                    : departments)
                            </td>
                            <td class="status-column">
                                @(item.Statuses.Any()
                                    ? string.Join(", ", item.Statuses)
                                    : "Not Reviewed")
                            </td>
                            <td class="actions-column">
                                <div class="d-grid gap-2">
                                    <a class="btn btn-secondary btn-sm"
                                       asp-controller="Grant"
                                       asp-action="ViewGrant"
                                       asp-route-id="@item.Id">
                                        View
                                    </a>

                                    @if (
                                        item.Statuses.Contains(GrantStatus.ApprovedARCC) &&
                                        item.AllocatedFunds > 0 &&
                                        !item.ReportSubmitted
                                    )
                                    {
                                        <a class="btn btn-warning btn-sm"
                                           asp-controller="Grant"
                                           asp-action="SubmitReport"
                                           asp-route-id="@item.Id">
                                            Submit Report
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="dashboard-table-container">
            <p class="dashboard-empty-state">
                You do not currently have any approved grants.
            </p>
        </div>
    }
</section>

