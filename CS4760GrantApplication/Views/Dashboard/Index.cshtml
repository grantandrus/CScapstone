@model IEnumerable<CS4760GrantApplication.Models.Grant>

@{
    ViewData["Title"] = "Dashboard";
}

<table class="table">
    <thead>
        <tr>
            <th>
                Grant Title
            </th>
            <th>
                Description
            </th>
            <th>
                Project Summary
            </th>
            <th>
                Justification
            </th>
            <th>
                Project Impact
            </th>
            <th>
                Multiple Departments
            </th>
            <th>
                College
            </th>
            <th>
                Department Name
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Title
                </td>
                <td>
                    @item.Description
                </td>
                
                <td>
                    @item.ProjectSummary
                </td>
                
                <td>
                    @item.Justification
                </td>
                
                <td>
                    @item.ProjectImpact
                </td>
                
                <td>
                    @item.isMultipleDepartments
                </td>
               
                @if (item.College == null)
                {
                    <td>
                        None
                    </td>
                }
                else
                {
                    <td>
                        @item.College.Name
                    </td>
                }
                
                <td>
                    @string.Join(", ", item.Departments.Select(d => d.DepartmentName))
                </td>
                @if (item.IsSaved)
                {
                    <td>
                        <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("Edit", "Grant", new { id = item.Id })'">Edit</button>
                    </td>
                }
            </tr>
        }
    </tbody>
</table>

<button type="button"
    class="btn btn-primary" 
    onclick="location.href='@Url.Action("Create", "Grant")'">
    Create Grant
</button>
