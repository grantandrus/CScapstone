@model CS4760GrantApplication.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}
<h2>Your Grants</h2>

<div class="mb-3">
    <button class="btn btn-outline-primary"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#notificationPanel">

        🔔 Notifications

        @if (Model.Notifications.Any())
        {
            <span class="badge bg-danger">
                @Model.Notifications.Count
            </span>
        }
    </button>

    <div class="collapse mt-2" id="notificationPanel">
        <div class="card card-body">

            @if (Model.Notifications.Any())
            {
                <ul class="list-group">
                    @foreach (var notification in Model.Notifications)
                    {
                        <li class="list-group-item">
                            @notification.Message
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="mb-0">No notifications.</p>
            }

        </div>
    </div>
</div>

<button type="button"
        class="btn btn-primary"
        onclick="location.href='@Url.Action("Create", "Grant")'">
    Create Grant
</button>


<h3 class="mt-4">Approved Grants (ARCC)</h3>

<table class="table">
    <thead>
        <tr>
            <th>Grant Title</th>
            <th>Description</th>
            <th>Project Summary</th>
            <th>Justification</th>
            <th>Project Impact</th>
            <th>Multiple Departments</th>
            <th>College</th>
            <th>Department Name</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.MyGrants.Where(g => g.Statuses.Contains(GrantStatus.ApprovedARCC)))
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Description</td>
                <td>@item.ProjectSummary</td>
                <td>@item.Justification</td>
                <td>@item.ProjectImpact</td>
                <td>@item.isMultipleDepartments</td>

                <td>
                    @(item.College == null ? "None" : item.College.Name)
                </td>

                <td>
                    @string.Join(", ", item.Departments.Select(d => d.DepartmentName))
                </td>
                @if (item.Statuses.Count() == 0)
                {
                    <td>
                        Not Reviewed
                    </td>
                }
                @foreach (var status in item.Statuses)
                {
                    <td>
                        @Html.DisplayFor(modelItem => status),
                    </td>
                }

                <td>
                    <button type="button" class="btn btn-secondary"
                            onclick="location.href='@Url.Action("ViewGrant", "Grant", new { id = item.Id })'">
                        View Grant
                    </button>
                    @if (item.AllocatedFunds > 0 && !item.ReportSubmitted)
                    {
                        <button type="button" class="btn btn-warning"
                                onclick="location.href='@Url.Action("SubmitReport", "Grant", new { id = item.Id })'">
                            Submit Report
                        </button>
                    }
                    @if (item.AllocatedFunds > 0 && item.ReportSubmitted)
                    {
                        <button type="button" class="btn btn-warning"
                                onclick="location.href='@Url.Action("ViewReport", "Grant", new { id = item.Id })'">
                            View Report
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

