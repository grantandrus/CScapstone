@model IEnumerable<CS4760GrantApplication.Models.Grant>

@{
    ViewData["Title"] = "Dashboard";
}

<table class="table">
    <thead>
        <tr>
            <th>
                Grant Title
            </th>
            <th>
                Description
            </th>
            <th>
                Project Summary
            </th>
            <th>
                Justification
            </th>
            <th>
                Project Impact
            </th>
            <th>
                Multiple Departments
            </th>
            <th>
                Department Name
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.Title
                </td>
                <td>
                    @item.Description
                </td>
                
                <td>
                    @item.ProjectSummary
                </td>
                
                <td>
                    @item.Justification
                </td>
                
                <td>
                    @item.ProjectImpact
                </td>
                
                <td>
                    @item.isMultipleDepartments
                </td>
                
                <td>
                    @item.Department?.DepartmentName
                </td>
            </tr>
        }
    </tbody>
</table>

<button type="button"
    class="btn btn-primary" 
    onclick="location.href='@Url.Action("Create", "Grant")'">
    Create Grant
</button>
