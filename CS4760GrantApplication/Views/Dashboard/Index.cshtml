@if (Model.IsDeptChair)
{
    <br />
    <br />
    <h2>Department Grants</h2>

    <table class="table">
        <thead>
            <tr>
                <th>
                    Grant Title
                </th>
                <th>
                    Description
                </th>
                <th>
                    Project Summary
                </th>
                <th>
                    Justification
                </th>
                <th>
                    Project Impact
                </th>
                <th>
                    Multiple Departments
                </th>
                <th>
                    College
                </th>
                <th>
                    Department Name
                </th>
                <th>
                    Status
                </th>
                <th>
                    Dept. Review
                </th>
                <th>
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.DepartmentGrants)
            {
                <tr>
                    <td>
                        @item.Title
                    </td>
                    <td>
                        @item.Description
                    </td>
                
                    <td>
                        @item.ProjectSummary
                    </td>
                
                    <td>
                        @item.Justification
                    </td>
                
                    <td>
                        @item.ProjectImpact
                    </td>
                
                    <td>
                        @item.isMultipleDepartments
                    </td>
               
                    @if (item.College == null)
                    {
                        <td>
                            None
                        </td>
                    }
                    else
                    {
                        <td>
                            @item.College.Name
                        </td>
                    }
                
                    <td>
                        @string.Join(", ", item.Departments.Select(d => d.DepartmentName))
                    </td>

                    @if (item.Statuses.Count() == 0)
                    {
                        <td>
                            Not Reviewed
                        </td>
                    }
                    @foreach (var status in item.Statuses)
                    {
                        <td>
                            @Html.DisplayFor(modelItem => status),
                        </td>
                    }

                    @if (!item.Statuses.Contains(GrantStatus.RejectedByDeptChair) && !item.Statuses.Contains(GrantStatus.ApprovedByDeptChair))
                    {
                        <td>
                            Not reviewed
                        </td>
                    }
                    else if (item.Statuses.Contains(GrantStatus.ApprovedByDeptChair))
                    {
                        <td>
                            Approved
                        </td>
                    }
                    else if (item.Statuses.Contains(GrantStatus.RejectedByDeptChair))
                    {
                        <td>
                            Rejected
                        </td>
                    }

                    <td>
                        <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("DeptReview", "Grant", new { id = item.Id })'">Review</button>
                    </td>
                
                </tr>
            }
        </tbody>
    </table>
}

@if (Model.IsCollegeDean)
{
    <br />
    <h2>Grants Requesting College Funding</h2>

    <table class="table">
        <thead>
            <tr>
                <th>
                    Grant Title
                </th>
                <th>
                    Description
                </th>
                <th>
                    Project Summary
                </th>
                <th>
                    Justification
                </th>
                <th>
                    Project Impact
                </th>
                <th>
                    Multiple Departments
                </th>
                <th>
                    College
                </th>
                <th>
                    Department Name
                </th>
                <th>
                    Status
                </th>
                <th>
                    College Review
                </th>
                <th>
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.CollegeGrants)
            {
                <tr>
                    <td>
                        @item.Title
                    </td>
                    <td>
                        @item.Description
                    </td>

                    <td>
                        @item.ProjectSummary
                    </td>

                    <td>
                        @item.Justification
                    </td>

                    <td>
                        @item.ProjectImpact
                    </td>

                    <td>
                        @item.isMultipleDepartments
                    </td>

                    @if (item.College == null)
                    {
                        <td>
                            None
                        </td>
                    }
                    else
                    {
                        <td>
                            @item.College.Name
                        </td>
                    }

                    <td>
                        @string.Join(", ", item.Departments.Select(d => d.DepartmentName))
                    </td>
                    @if (item.Statuses.Count() == 0)
                    {
                        <td>
                            Not Reviewed
                        </td>
                    }
                    @foreach (var status in item.Statuses)
                    {
                        <td>
                            @Html.DisplayFor(modelItem => status), 
                        </td>
                    }

                    @if (!item.Statuses.Contains(GrantStatus.RejectedDean) && !item.Statuses.Contains(GrantStatus.ApproveDean))
                    {
                        <td>
                            Not reviewed
                        </td>
                    }
                    else if (item.Statuses.Contains(GrantStatus.ApproveDean))
                    {
                        <td>
                            Approved
                        </td>
                    }
                    else if (item.Statuses.Contains(GrantStatus.RejectedDean))
                    {
                        <td>
                            Rejected
                        </td>
                    }

                    <td>
                        <button type="button" class="btn btn-secondary" onclick="location.href='@Url.Action("CollegeReview", "Grant", new { id = item.Id })'">Review</button>
                    </td>

                </tr>
            }
        </tbody>
    </table>
}